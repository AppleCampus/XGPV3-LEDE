#!/bin/sh
# 12-xgp-mt7922-wifi: MT7922 default AP to 5GHz on first boot.
#
# A clean install leaves the MT7922 AP on 6GHz, which many clients can't use
# (and 6GHz often fails to come up without proper regulatory setup), forcing
# a wired connection just to reconfigure. When an MT7922 is detected, default
# its AP to 5GHz, channel 40, 160MHz instead.
#
# Runs once via uci-defaults on first boot. Does nothing if already configured.

# --- 1. Detect MediaTek MT7922 (PCI 14c3:0616) ---
mt7922_pci=""
for d in /sys/bus/pci/devices/*; do
    [ -f "$d/vendor" ] || continue
    v=$(cat "$d/vendor" 2>/dev/null)
    dev=$(cat "$d/device" 2>/dev/null)
    if [ "$v" = "0x14c3" ]; then
        case "$dev" in
            0x0616|0x7922) mt7922_pci=$(basename "$d"); break ;;
        esac
    fi
done
[ -n "$mt7922_pci" ] || exit 0

# --- 2. Ensure a wireless config exists ---
[ -f /etc/config/wireless ] || wifi config

. /lib/functions.sh
config_load wireless

# --- 3. Configure MT7922 radios to 5GHz AP defaults ---
handle_radio() {
    local section="$1" path
    config_get path "$section" path
    case "$path" in
        *"$mt7922_pci"*) ;;
        *) return 0 ;;
    esac
    # This radio belongs to the MT7922: use 5GHz, channel 40, 160MHz.
    uci set wireless.$section.band="5g"
    uci set wireless.$section.channel="40"
    uci set wireless.$section.htmode="HE160"
    uci set wireless.$section.disabled="0"
}

config_foreach handle_radio wifi-device
uci commit wireless

exit 0
